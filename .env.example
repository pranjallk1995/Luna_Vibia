# Copy this file to .env and replace every placeholder before starting Vibia.

# Password of this app's role on Luna Sentia's shared PostgreSQL (luna-sentia-db).
# Must equal LUNAVIBIA_DB_PASSWORD in Luna_Sentia/.env.
POSTGRES_PASSWORD=lunavibia-dev

# Model served by Luna Sentia that writes captions and tags from what CLAP heard;
# it must be listed in Sentia's SENTIA_MODELS.
CAPTION_MODEL=qwen3-vl:8b-instruct
# Where CLAP listens to tracks and embeds searches: auto, cuda, or cpu.
CLAP_DEVICE=auto
# Optional: Sentia's Ollama endpoint on the shared luna_sentia_network.
OLLAMA_URL=http://luna-sentia-ollama:11434

# Luna Visia's API on luna_sentia_network, which cover-art URLs are checked against.
LUNAVISIA_API_URL=http://luna-visia-mcp:8000

# Shared with Luna Vita and Luna Vibia so they can store generated images in Luna Visia
# (food images, cover art). Use the same random value in all three .env files, e.g.
# from `openssl rand -hex 32`; leave it empty to keep that off.
LUNAVISIA_COMPANION_TOKEN=

# Visia image ID of the audio placeholder that covers tracks no Visia image suits.
# Leave blank until it is stored in Visia; those tracks then show the UI's generated placeholder.
LUNAVIBIA_PLACEHOLDER_COVER_ID=

# Public MCP/API origin used when Vibia creates stable, playable track URLs.
# Leave blank when public track URLs are not needed.
LUNAVIBIA_PUBLIC_BASE_URL=

# Private UI-to-backend credential. This is not issued by any service: make up your own
# random value of at least 32 characters, e.g. with `openssl rand -hex 32`.
# The default works on localhost; set your own before giving this app a public (https)
# address, and the same value as LUNAVIBIA_API_TOKEN in Luna_Sentia/.env.
# LUNAVIBIA_API_TOKEN=lunavibia-dev-token-for-localhost-only

# Who may use this app, among the people Luna Sentia lets sign in: blank (the default) for
# Sentia's owner only, * for all of them, or a comma-separated list. The owner always may.
# LUNAVIBIA_ALLOWED_EMAILS=*

# The host's PulseAudio (or PipeWire) socket, through which play_tracks reaches its speakers.
# The default is WSLg's on Windows; on Linux it is usually /run/user/1000/pulse/native.
PULSE_SOCKET=/mnt/wslg/PulseServer
# Under WSL: the Windows speaker helper (host/speaker_helper.py), which lists Windows'
# connected Bluetooth speakers and switches to the one asked for. Leave blank on Linux.
LUNAVIBIA_SPEAKER_HELPER_URL=http://host.docker.internal:18007

# Public origin of the MCP server, used for its icon URLs.
# Must be HTTPS when exposed publicly; plain HTTP is accepted only on localhost.
MCP_PUBLIC_URL=http://localhost:18003
# The address people open this app's web UI at; the get_ui_link MCP tool gives it out.
UI_PUBLIC_URL=http://localhost:18504

# Single sign-on through Luna Sentia: the auth service's public address (SENTIA_AUTH_PUBLIC_URL
# in Luna_Sentia/.env), and its address on luna_sentia_network; https://auth.example.com
# with a tunnel.
LUNA_SSO_URL=http://localhost:19001
LUNA_SSO_INTERNAL_URL=http://luna-sentia-auth:8000
